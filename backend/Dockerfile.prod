# syntax=docker/dockerfile:1

# ---- Estágio 1: dependências de produção (sem pacotes de dev) ----
FROM composer:2 AS vendor
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction --ignore-platform-reqs
COPY . .
RUN composer dump-autoload --no-dev --classmap-authoritative --no-scripts --ignore-platform-reqs

# ---- Estágio 2: imagem final (FrankenPHP = Caddy + PHP, sem nginx/fpm separados) ----
FROM dunglas/frankenphp:1-php8.4 AS production

RUN install-php-extensions pdo_mysql bcmath intl zip opcache pcntl redis \
    && apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

ENV APP_ENV=production \
    APP_DEBUG=false \
    SERVER_NAME=:8080 \
    XDG_CONFIG_HOME=/config \
    XDG_DATA_HOME=/data

WORKDIR /app

COPY docker/php.ini /usr/local/etc/php/conf.d/zz-app.ini
COPY docker/Caddyfile /etc/caddy/Caddyfile
COPY docker/entrypoint.sh /usr/local/bin/app-entrypoint
COPY --from=vendor --chown=www-data:www-data /app /app

# O processo roda sem privilégios (porta 8080, sem precisar de root).
RUN chmod +x /usr/local/bin/app-entrypoint \
    && mkdir -p /config/caddy /data/caddy storage/app/public storage/framework/cache/data \
        storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && chown -R www-data:www-data /config /data storage bootstrap/cache \
    && su www-data -s /bin/sh -c "php artisan package:discover --ansi"

USER www-data
EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=40s --retries=5 \
    CMD curl -fsS http://localhost:8080/up || exit 1

ENTRYPOINT ["app-entrypoint"]
CMD ["--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
