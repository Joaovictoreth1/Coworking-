# Copie para .env.production e preencha. NUNCA commite o arquivo preenchido.

# --- Site ---
# Domínio com HTTPS automático. Para testar localmente use ":80".
SITE_ADDRESS=coworking.example.com
HTTP_PORT=80
HTTPS_PORT=443

# --- Laravel ---
APP_NAME=Coworking
APP_ENV=production
APP_DEBUG=false
APP_URL=https://coworking.example.com
# Gere com: docker run --rm --entrypoint php coworking-prod-app artisan key:generate --show
APP_KEY=
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
COWORKING_TIMEZONE=America/Sao_Paulo
LOG_CHANNEL=stderr
LOG_LEVEL=warning
BCRYPT_ROUNDS=12

# Mesma origem (frontend e API no mesmo domínio): basta o próprio site.
CORS_ALLOWED_ORIGINS=https://coworking.example.com
# O backend só é alcançável pelo proxy (rede interna do compose).
TRUSTED_PROXIES=*

# --- Banco (MySQL) ---
DB_DATABASE=coworking
DB_USERNAME=coworking
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Cache / sessão / fila ---
CACHE_STORE=redis
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
REDIS_CLIENT=phpredis
